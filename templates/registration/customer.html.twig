{% extends 'auth/layout.html.twig' %}

{% block meta_description %}Créez votre compte client Restauria pour retrouver vos restaurants favoris.{% endblock %}

{% block page_title %}Créer un compte{% endblock %}

{% block heading %}Créer un compte{% endblock %}

{% block lead %}Créez votre espace client pour retrouver vos restaurants favoris.{% endblock %}

{% block auth_body %}
    <form class="form-stack auth-form" method="post" action="{{ path('app_register') }}">
        <label class="form-field">
            <span class="form-field__label">Nom</span>
            <input type="text" name="name" value="{{ form_data.name }}" placeholder="Saisissez nom..." class="form-control" autocomplete="name" required>
        </label>
        <label class="form-field">
            <span class="form-field__label">Email</span>
            <input type="email" name="email" value="{{ form_data.email }}" placeholder="Saisissez email..." class="form-control" autocomplete="email" required>
        </label>
        {{ include('auth/_password_field.html.twig', {autocomplete: 'new-password'}) }}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
        {{ include('auth/_demo_form_footer.html.twig', {submit_label: 'Créer mon compte', error: error}) }}
    </form>
{% endblock %}

{% block footer_links %}
    <p>Déjà un compte ? <a href="{{ path(audience.routeName('app_login')) }}">Se connecter</a></p>
{% endblock %}
