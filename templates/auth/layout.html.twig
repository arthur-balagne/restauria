{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}{% endblock %} | Restauria{% endblock %}

{% block content %}
    <div class="auth-shell">
        {{ include('auth/_sidebar.html.twig') }}
        <main id="main-content" class="auth-main reveal-on-load">
            {{ include('auth/_mobile_brand.html.twig') }}
            <div class="auth-header">
                <span class="auth-header__eyebrow">{{ audience.spaceLabel }}</span>
                <h1>{% block heading %}{% endblock %}</h1>
                <p>{% block lead %}{% endblock %}</p>
            </div>
            {% block auth_body %}{% endblock %}
            <div class="auth-footer">
                {% block footer_links %}{% endblock %}
                {{ include('auth/_switch_audience_link.html.twig') }}
            </div>
        </main>
    </div>
{% endblock %}
