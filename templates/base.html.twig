<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}Restauria, la commande à table et à emporter pour les restaurants.{% endblock %}">
        <title>{% block title %}Restauria{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.svg') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block content %}
            <a class="skip-link" href="#main-content">Aller au contenu principal</a>
            {% block header %}
                <header class="marketing-header">
                    <div class="marketing-header__inner">
                        <a class="brand-mark" href="{{ path('app_home') }}" aria-label="Restauria, accueil">
                            <span class="brand-mark__symbol" aria-hidden="true">R</span>
                            <span class="brand-mark__name">Restauria</span>
                        </a>
                        <button class="marketing-menu-toggle" type="button" aria-label="Ouvrir la navigation" aria-expanded="false" data-public-menu-toggle>
                            <span></span><span></span><span></span>
                        </button>
                        {% set _is_restaurant = app.request and 'restaurant' in app.request.attributes.get('_route', '') %}
                        <nav class="marketing-nav" aria-label="Navigation principale">
                            {% block navigation_menu %}
                                {{ include('menu/_marketing_nav.html.twig', { menu: knp_menu_get(_is_restaurant ? 'restaurant' : 'customer') }) }}
                            {% endblock %}
                        </nav>
                        {% block marketing_actions %}
                            <div class="marketing-actions">
                                {{ include('menu/_marketing_nav.html.twig', { menu: knp_menu_get(_is_restaurant ? 'restaurant_actions' : 'customer_actions') }) }}
                            </div>
                        {% endblock %}
                    </div>
                </header>
            {% endblock %}
            <main id="main-content">
                {% block body %}{% endblock %}
            </main>
            {% block footer %}
                <footer class="site-footer">
                    <div class="footer-inner">
                        <div class="footer-brand">
                            <a class="brand-mark" href="{{ path('app_home') }}" aria-label="Restauria, accueil">
                                <span class="brand-mark__symbol brand-mark__symbol--inverted" aria-hidden="true">R</span>
                                <span class="brand-mark__name brand-mark__name--inverted">Restauria</span>
                            </a>
                            <p>Explorez la carte, choisissez votre façon de commander et savourez le moment.</p>
                        </div>
                    </div>
                    <div class="footer-bottom">
                        <span>© Restauria.</span>
                        <span>Une expérience pensée pour le plaisir de la table.</span>
                    </div>
                </footer>
            {% endblock %}
        {% endblock %}
    </body>
</html>
